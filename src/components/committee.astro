---
const rawMembers = [
  { name: "Arleo, Alessio", affiliation: "TU Eindhoven" },
  { name: "Mariani, Ilaria", affiliation: "Politecnico di Milano" },
  { name: "Tuscher, Michaela", affiliation: "TU Wien" },
  { name: "Marin, Diana", affiliation: "TU Wien" },
  { name: "Filipov, Velitchko", affiliation: "TU Wien" },
  { name: "Amabili, Lorenzo", affiliation: "Buzzi RTD" },
  { name: "Wu, Hsiang-Yun", affiliation: "University of Applied Sciences St. Pölten" },
  { name: "Pahr, Daniel", affiliation: "University of Vienna" },
  { name: "Keck, Mandy", affiliation: "University of Applied Sciences Upper Austria" },
  { name: "Menin, Aline", affiliation: "INRIA Saclay" },
  { name: "Isenberg, Petra", affiliation: "INRIA Saclay" },
  { name: "De Angeli, Daniela", affiliation: "University of Applied Sciences St. Pölten" },
  { name: "De-Jesus-Oliveira, Victor-Adriel", affiliation: "University of Applied Sciences St. Pölten" },
  { name: "Boucher, Magdalena", affiliation: "University of Applied Sciences St. Pölten" },
  { name: "Rajabiyazdi, Fateme", affiliation: "University of Calgary" },
  { name: "Ceneda, Davide", affiliation: "TU Eindhoven" },
  { name: "Dunn, Sarah", affiliation: "University of Edinburgh" },
  { name: "Stoiber, Christina", affiliation: "University of Applied Sciences St. Pölten" },
  { name: "Rusnak, Vit", affiliation: "Masaryk University" },
  { name: "Wallner, Günter", affiliation: "Johannes Kepler University Linz" },
  { name: "Becker, Franziska", affiliation: "University of Stuttgart" },
  { name: "Warnking, Rene", affiliation: "University Hospital Mannheim" },
  { name: "Nagel, Till", affiliation: "Technische Hochschule Mannheim" },
  { name: "Raidou, Renata Georgia", affiliation: "TU Wien" },
  { name: "Gröller, Eduard", affiliation: "TU Wien" },
  { name: "Miksch, Silvia", affiliation: "TU Wien" },
  { name: "Gobbo, Beatrice", affiliation: "Politecnico di Milano" },
  { name: "Pelchmann, Laura", affiliation: "University of Cologne" },
  { name: "Eschner, Johannes", affiliation: "TU Wien" },
  { name: "Kriglstein, Simone", affiliation: "Masaryk University" },
  { name: "Größbacher, Stefanie", affiliation: "University of Applied Sciences St. Pölten" },
  { name: "Kejstová, Magdaléna", affiliation: "Masaryk University" }
];

// Convert names from "LastName, FirstName" to "FirstName LastName" and sort alphabetically by last name
const committeeMembers = rawMembers.map(member => {
  const [lastName, firstName] = member.name.split(',').map(s => s.trim());
  return {
    displayName: `${firstName} ${lastName}`,
    lastName: lastName,
    affiliation: member.affiliation
  };
}).sort(() => Math.random() - 0.5);
---

<main class="pb-8 md:pt-12 md:pb-12 fade-in-section" data-fade>
  <div class="max-w-6xl mx-auto p-8">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mb-6">
        Program Committee
      </h2>
        <!-- Count Display with Pink Flair -->
    <div class="mt-12 text-center">
      <div class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-pink-50 via-pink-100/50 to-pink-50 rounded-full border border-pink-200/50 shadow-sm">
        <span class="text-2xl">✨</span>
        <p class="text-slate-700 text-sm font-medium">
          <span class="font-bold text-[#FF69B4] text-lg">{committeeMembers.length}</span> distinguished committee members
        </p>
        <span class="text-2xl">✨</span>
      </div>
    </div>
      <p class="text-lg mt-4 text-slate-600">
        Meet the VisGames 2026 Program Committee:
      </p>
    </div>

    <!-- Committee Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {committeeMembers.map((member, index) => (
        <div class="group relative bg-gradient-to-br from-white via-pink-50/30 to-slate-50 rounded-lg p-5 border border-slate-200 hover:border-[#FF69B4] hover:shadow-xl hover:shadow-pink-200/50 transition-all duration-300 ease-in-out transform hover:-translate-y-1 overflow-hidden">
          {/* Pink accent corner */}
          <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-br from-[#FF69B4]/20 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          {/* Pink sparkle effect */}
          <div class="absolute -top-1 -right-1 w-3 h-3 bg-[#FF69B4] rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:animate-ping"></div>
          
          <div class="flex flex-col h-full relative z-10">
            <h3 class="text-lg font-semibold text-slate-800 group-hover:text-[#FF69B4] transition-colors duration-200">
              {member.displayName}
            </h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
              {member.affiliation}
            </p>
          </div>
          
          {/* Bottom accent line */}
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#FF69B4] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      ))}
    </div>

  
  </div>
</main>

<style>
  .fade-in-section {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .fade-in-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeElements = document.querySelectorAll('.fade-in-section');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, {
      threshold: 0.1
    });

    fadeElements.forEach(element => {
      observer.observe(element);
    });
  });
</script>
